{
  "name": "@formweave/engine",
  "version": "0.0.0",
  "description": "Framework-free formweave engine: compile, evaluate, validate.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-moradi-design/form-builder.git",
    "directory": "packages/engine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expr": {
      "types": "./dist/expr.d.ts",
      "default": "./dist/expr.js"
    },
    "./fields": {
      "types": "./dist/fields/index.d.ts",
      "default": "./dist/fields/index.js"
    },
    "./fields/all": {
      "types": "./dist/fields/all.d.ts",
      "default": "./dist/fields/all.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "dependencies": {
    "@formweave/schema": "workspace:^"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "zod": "4.6.7"
  },
  "size-limit": [
    {
      "name": "core (compile + evaluate)",
      "path": "dist/index.js",
      "import": "{ compile, evaluate, createRegistry }",
      "limit": "3 kB"
    },
    {
      "name": "expr",
      "path": "dist/expr.js",
      "limit": "2 kB"
    },
    {
      "name": "one field (shortText)",
      "path": "dist/fields/index.js",
      "import": "{ shortText }",
      "limit": "600 B"
    },
    {
      "name": "all fields",
      "path": "dist/fields/all.js",
      "limit": "3 kB"
    }
  ],
  "peerDependencies": {
    "zod": "^4.6.0"
  }
}
