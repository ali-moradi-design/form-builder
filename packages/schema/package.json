{
  "name": "@formcanvas/schema",
  "version": "0.1.0",
  "description": "Types and the meta-schema of formcanvas form documents.",
  "keywords": [
    "form",
    "forms",
    "form-builder",
    "json-schema",
    "schema",
    "zod",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ali Moradi",
  "homepage": "https://github.com/ali-moradi-design/formcanvas/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/ali-moradi-design/formcanvas/issues"
  },
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-moradi-design/formcanvas.git",
    "directory": "packages/schema"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "default": "./dist/meta.js"
    },
    "./schema.json": "./dist/form-document.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/json-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "types and constants",
      "path": "dist/index.js",
      "limit": "300 B"
    },
    {
      "name": "meta-schema with zod/mini",
      "path": "dist/meta.js",
      "limit": "2 kB"
    }
  ],
  "devDependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
