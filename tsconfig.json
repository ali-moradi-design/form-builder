{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "isolatedDeclarations": false,
    "declaration": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "*.js",
    "*.ts",
    "packages/*/*.ts",
    "packages/*/scripts/*.mjs",
    "apps/*/*.ts",
    "apps/*/*.js",
    "apps/*/*.mjs",
    "apps/*/scripts/*.mjs",
    "scripts/*.mjs"
  ]
}
